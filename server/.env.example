# MongoDB Atlas Connection String
# Replace <username>, <password>, and cluster URL with your MongoDB Atlas details
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/cpsheet?retryWrites=true&w=majority

# Port for backend Express server (Cloud platforms like Render assign PORT automatically)
PORT=5000

# Frontend URL for CORS (e.g., https://your-app.vercel.app or http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Secret key used to sign user login tokens (make this a long random string in production)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Optional: Seed passkey for setupPasskey.js script
ADMIN_PASSKEY=your_secret_admin_passkey
